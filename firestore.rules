rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- existing collections (unchanged behaviour) --------------------------------------
    match /leaderboard/{doc=**} { allow read: if true; allow write: if request.auth != null; }
    match /plays/{doc=**}       { allow read: if true; allow write: if true; }

    // ---- shared daily play counter (Featured rail: top 3 played today) --------------------
    match /daily_plays/{date}/games/{gameId} { allow read: if true; allow write: if true; }

    // ---- user profiles (written at every login by firebase-auth.js) --------------------------
    // Owner can read/write their own profile, but can never set or change `plan` (only you / the server).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && !('plan' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.get('plan', null) == resource.data.get('plan', null);
      allow delete: if false;
    }

    // ---- manual review (written ONLY by pg-review-worker.js with a service account) ----------
    match /submissions/{sid} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /system/{doc=**} { allow read, write: if false; }

    // ---- likes (firebase-auth.js like button: +1 on `likes` only) ---------------------------
    match /games/{gid} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['likes']);
      allow update: if request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
    }

    // ---- community games (Publish) --------------------------------------------------------
    // Public: only 'published' games (set by the review service on approval). Owner: all of their own.
    match /community_games/{gameId} {
      allow read: if resource.data.status == 'published'
                  || (request.auth != null && request.auth.uid == resource.data.ownerUid);
      // The playable copy can only be created for a submission that the review service has DELIVERED
      // (Drive + email both succeeded => submissions/{id}.status == 'pending_review') for this same user.
      // A browser can no longer create a game as 'published' itself.
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.status == 'pending_review'
                    && request.resource.data.title is string && request.resource.data.title.size() <= 60
                    && request.resource.data.chunkCount is int && request.resource.data.chunkCount <= 8
                    && exists(/databases/$(database)/documents/submissions/$(gameId))
                    && get(/databases/$(database)/documents/submissions/$(gameId)).data.user_id == request.auth.uid
                    && get(/databases/$(database)/documents/submissions/$(gameId)).data.status == 'pending_review';
      // Owner can edit listing text, never status/ownership (approval/rejection is server-only).
      allow update: if request.auth != null && request.auth.uid == resource.data.ownerUid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'controls', 'genre', 'orientation', 'thumb']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;

      match /chunks/{chunkId} {
        allow read: if get(/databases/$(database)/documents/community_games/$(gameId)).data.status == 'published'
                    || (request.auth != null && request.auth.uid == get(/databases/$(database)/documents/community_games/$(gameId)).data.ownerUid);
        allow create: if request.auth != null
                      && request.auth.uid == get(/databases/$(database)/documents/community_games/$(gameId)).data.ownerUid;
        allow update: if false; // chunks are immutable once written
        allow delete: if request.auth != null   // owner deleting their game (Creator Studio > Delete)
                      && request.auth.uid == get(/databases/$(database)/documents/community_games/$(gameId)).data.ownerUid;
      }
    }

    // ---- tournaments ------------------------------------------------------------------------
    // Single-elimination brackets. Anyone can read. Any signed-in user can create one (they become
    // its owner) and can JOIN (append exactly themselves) while registration is open. Only the owner
    // can change anything else: add/remove players, start it, enter results, delete it.
    match /tournaments/{tid} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.name is string && request.resource.data.name.size() <= 60
                    && request.resource.data.limit is int && request.resource.data.limit >= 2 && request.resource.data.limit <= 500
                    && request.resource.data.players.size() == 0
                    && (!('description' in request.resource.data) || request.resource.data.description.size() <= 300);
      allow update: if request.auth != null && (
                      // owner: full control, but ownership can never be reassigned
                      (request.auth.uid == resource.data.ownerUid
                        && request.resource.data.ownerUid == resource.data.ownerUid
                        && request.resource.data.limit is int && request.resource.data.limit >= 2 && request.resource.data.limit <= 500
                        && request.resource.data.players.size() <= request.resource.data.limit)
                      ||
                      // anyone else: join = append exactly one player (themselves) and touch nothing else
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players'])
                        && request.resource.data.players.size() == resource.data.players.size() + 1
                        && request.resource.data.players.size() <= resource.data.limit
                        && request.resource.data.players[request.resource.data.players.size() - 1].uid == request.auth.uid
                        && (!('status' in resource.data) || resource.data.status == 'registration' || resource.data.status == 'upcoming')
                        && (!('registration' in resource.data) || resource.data.registration == 'open'))
                    );
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    // ---- creator lab requests (private to the requester) -------------------------------------
    match /creator_requests/{rid} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
    }

    // ---- game-report / abuse reports ---------------------------------------------------------
    match /bug_reports/{rid} {
      allow create: if true;
      allow read, update, delete: if false; // staff only, via the Firebase console
    }
  }
}
